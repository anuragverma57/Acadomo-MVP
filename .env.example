# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string.
# Local dev:  postgresql://USER@localhost:5432/acadomo_dev
# Production: Supabase TRANSACTION POOLER (port 6543), from
#   Project Settings -> Database -> Connection string -> URI
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Never prefix this with NEXT_PUBLIC_ — that would ship the password to browsers.
DATABASE_URL=

# Secret for signing session JWTs.
# Generate with: openssl rand -base64 32
# Use a DIFFERENT value in production than in development.
JWT_SECRET=

# Seeded admin account (Phase 1 seed script).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend API key for student OTP email delivery (Phase 5.5).
RESEND_API_KEY=

# Sender for OTP emails (optional; defaults to Resend's onboarding sender).
EMAIL_FROM=

# Emergency off switch for the service worker. Set to 1 in Vercel and redeploy
# to unregister it and clear its caches on every client. Leave empty normally.
NEXT_PUBLIC_DISABLE_SW=

# Demo mode: shows the one-time code in the UI instead of emailing it, so the
# sign-in flow is demonstrable without an email provider.
# SECURITY: anyone can then read a code for any address — enable ONLY on a
# throwaway demo deployment, never with real users. Ignored when
# RESEND_API_KEY is set.
NEXT_PUBLIC_DEMO_OTP=
